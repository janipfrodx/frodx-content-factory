{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Opisna referenca za izhodni package (state.json brez bloka _run, po koraku 7 - glej plugins/content-factory/skills/frodx-content-factory/references/state-schema.md). Ni programsko izvršena: v projektu ni odvisnosti jsonschema (Global Constraint: samo standardna knjižnica). Dejanski gate je plugins/content-factory/skills/frodx-publish-send/scripts/validate_package.py.",
  "title": "FrodX Content Factory paket",
  "type": "object",
  "required": ["meta", "universal", "social_posts", "languages"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "exported_at", "version"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "exported_at": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "const": "1.1" }
      }
    },
    "universal": {
      "type": "object",
      "required": ["slug"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
      }
    },
    "social_posts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "publish_date": {
            "type": "string",
            "description": "Neobvezno. Ta veriga ga ne zapolni - datum objave izbere Igor v aplikaciji. Polje je prisotno za skladnost z Igorjevim izvornim formatom (glej igor-column-writer/references/publishing-contract.md)."
          }
        }
      }
    },
    "languages": {
      "type": "object",
      "required": ["sl", "en", "hr"],
      "additionalProperties": false,
      "properties": {
        "sl": { "$ref": "#/$defs/language" },
        "en": { "$ref": "#/$defs/language" },
        "hr": { "$ref": "#/$defs/language" }
      }
    }
  },
  "$defs": {
    "language": {
      "type": "object",
      "required": [
        "language_code", "content", "slug", "seo_title", "meta_description",
        "topic_cluster", "campaign_name", "tag_id", "tag_name", "tag_slug",
        "featured_image_alt"
      ],
      "additionalProperties": false,
      "properties": {
        "language_code": { "enum": ["sl", "en", "hr"] },
        "content": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "seo_title": { "type": "string", "minLength": 1, "maxLength": 65 },
        "meta_description": { "type": "string", "minLength": 140, "maxLength": 160 },
        "topic_cluster": { "type": "string", "minLength": 1 },
        "campaign_name": { "type": "string", "pattern": "^Interest - " },
        "tag_id": { "type": "string" },
        "tag_name": { "type": "string" },
        "tag_slug": { "type": "string" },
        "featured_image_alt": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    }
  }
}
